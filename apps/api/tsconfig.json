{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true
  },
  /* รวมสคริปต์ใน prisma/ ทั้งหมด ไม่ใช่แค่ seed.ts — เพราะบนเซิร์ฟเวอร์ที่ deploy ด้วย Docker
     ไม่มี ts-node/tsconfig ให้ใช้ ต้องเรียกไฟล์ที่คอมไพล์แล้ว (dist/prisma/*.js) */
  "include": ["src/**/*", "prisma/*.ts"],
  "exclude": ["node_modules", "dist"]
}
