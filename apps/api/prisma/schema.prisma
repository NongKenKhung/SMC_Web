// SML — Prisma schema
// dev ใช้ SQLite | production เปลี่ยน provider เป็น "postgresql" + DATABASE_URL ใหม่
// หมายเหตุ: หลีกเลี่ยง enum/Json เพื่อให้สลับ SQLite ↔ Postgres ได้โดยไม่แก้ schema
//  - role: "ADMIN" | "EDITOR"            (string)
//  - category: "ACTIVITY" | "NEWS" | "WORK" (string)
//  - SiteContent.valueTh/valueEn เก็บ JSON string

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("EDITOR")
  createdAt    DateTime @default(now())
}

model Solution {
  id         Int        @id @default(autoincrement())
  slug       String     @unique
  parentId   Int?
  parent     Solution?  @relation("SolutionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Solution[] @relation("SolutionTree")
  order      Int        @default(0)
  published  Boolean    @default(true)
  icon       String?
  nameTh     String
  nameEn     String?
  summaryTh  String?
  summaryEn  String?
  bodyTh     String?
  bodyEn     String?
  layout     String   @default("TEXT") // TEXT = หน้าเนื้อหาปกติ | BROCHURE = รูปโบรชัวเต็มหน้า
  // ราคาต่อระบบ (บาท) — ว่าง = ยังไม่กำหนด จะไม่ขึ้นในตารางราคา
  // ใช้ Decimal ไม่ใช่ Float เพราะเงินห้ามคลาดเคลื่อนจากเลขฐานสอง
  price      Decimal? @db.Decimal(12, 2)
  coverImage String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Partner {
  id         Int     @id @default(autoincrement())
  name       String
  captionTh  String? @map("caption") // คำกำกับใต้โลโก้ (ไทย)
  captionEn  String? // คำกำกับใต้โลโก้ (อังกฤษ) — ว่างแล้วจะ fallback เป็นไทย
  logoUrl    String?
  websiteUrl String?
  order      Int     @default(0)
  published  Boolean @default(true)
}

model Post {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  category    String   @default("ACTIVITY")
  titleTh     String
  titleEn     String?
  excerptTh   String?
  excerptEn   String?
  bodyTh      String?
  bodyEn      String?
  coverImage  String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteContent {
  key       String   @id
  valueTh   String?
  valueEn   String?
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        Int       @id @default(autoincrement())
  name      String
  org       String?
  email     String
  phone     String?
  topic     String?
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
}

model Media {
  id          Int          @id @default(autoincrement())
  filename    String // ชื่อไฟล์ตอนอัปโหลด (ใช้เป็นชื่อตอนดาวน์โหลด)
  storedName  String? // ชื่อไฟล์จริงบนดิสก์ — ใช้ตอนลบ ไม่ต้อง parse url
  url         String // /uploads/xxx
  mime        String
  size        Int
  kind        String       @default("IMAGE") // IMAGE | FILE
  width       Int?
  height      Int?
  altTh       String?
  altEn       String?
  createdAt   DateTime     @default(now())
  attachments Attachment[]

  @@index([kind, createdAt])
}

// รายการเนื้อหาซ้ำ ๆ ทุกชนิดใช้ตารางนี้ร่วมกัน (Phase 6B)
// group = home.pillars | home.techs | about.timeline | about.story | solution.features:<id>
// เพิ่มชุดใหม่ = เพิ่มค่า group ไม่ต้องแก้โครงฐานข้อมูล
model Block {
  id         Int     @id @default(autoincrement())
  group      String
  order      Int     @default(0)
  published  Boolean @default(true)
  icon       String? // ชื่อไอคอนในชุดของเว็บ หรือ url รูป
  titleTh    String
  titleEn    String?
  subtitleTh String? // ใช้เป็น "ปี" ใน timeline หรือคำกำกับ (เช่น Research)
  subtitleEn String?
  bodyTh     String? // HTML ที่ sanitize แล้ว
  bodyEn     String?
  image      String?
  meta       String? // JSON string เผื่อ field เฉพาะทางในอนาคต

  @@index([group, order])
}

// ตารางกลาง: ผูก media เข้ากับรายการอะไรก็ได้ (แกลเลอรี/ไฟล์แนบ/poster)
// เพิ่มชนิดใหม่ภายหลัง = เพิ่มค่า role ไม่ต้องแก้โครง
model Attachment {
  id        Int     @id @default(autoincrement())
  mediaId   Int
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  ownerType String // SOLUTION | POST | PAGE
  ownerId   String // id ของ solution/post หรือ slug ของหน้า (String เพื่อรองรับทั้งคู่)
  role      String // GALLERY | DOWNLOAD | POSTER
  order     Int     @default(0)
  captionTh String?
  captionEn String?

  @@index([ownerType, ownerId, role, order])
}
