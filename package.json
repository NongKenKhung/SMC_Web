{
  "name": "sml-web",
  "private": true,
  "version": "0.1.0",
  "description": "SMC — Smart City Research Center (KMITL) website monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "//postinstall": "npm ยก @prisma/client ขึ้นมาไว้ node_modules ที่ root ทำให้ postinstall ของมันหา apps/api/prisma/schema.prisma ไม่เจอ แล้วปล่อย client ตัวปลอมที่ throw ทิ้งไว้ — ต้อง generate เองโดยชี้ schema ให้ตรง (คำสั่งนี้ไม่ต้องใช้ DATABASE_URL และไม่ต้องต่อฐานข้อมูล)",
  "scripts": {
    "postinstall": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "dev": "concurrently -n api,web -c cyan,magenta npm:dev:api npm:dev:web",
    "dev:api": "npm run dev -w @sml/api",
    "dev:web": "npm run dev -w @sml/web",
    "db:up": "docker compose up -d",
    "db:stop": "docker compose stop",
    "db:seed": "npm run seed -w @sml/api",
    "db:seed:demo": "npm run seed:demo -w @sml/api",
    "db:seed:demo:clear": "npm run seed:demo:clear -w @sml/api",
    "db:clean:uploads": "npm run clean:uploads -w @sml/api",
    "db:admin:password": "npm run admin:password -w @sml/api",
    "build": "npm run build --workspaces --if-present",
    "prod": "npm run build && npm start",
    "start": "concurrently -n api,web -c cyan,magenta npm:start:api npm:start:web",
    "start:api": "npm run start -w @sml/api",
    "start:web": "npm run start -w @sml/web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "//overrides": "ปัก @tiptap ทั้งชุดไว้ที่ 3.29.2 เท่ากับที่ pnpm เคย lock ไว้ — @tiptap/react กับ starter-kit ประกาศ dependency พี่น้องเป็น ^3.0.0 ถ้าปล่อยให้ npm resolve เอง จะได้ @tiptap/core สองชุด (3.29.2 ใน apps/web + 3.30.0 ที่ root) แล้ว editor ในหน้า admin พัง เพราะ ProseMirror ใช้ instanceof เทียบ schema/plugin",
  "overrides": {
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-blockquote": "3.29.2",
    "@tiptap/extension-bold": "3.29.2",
    "@tiptap/extension-bubble-menu": "3.29.2",
    "@tiptap/extension-bullet-list": "3.29.2",
    "@tiptap/extension-code": "3.29.2",
    "@tiptap/extension-code-block": "3.29.2",
    "@tiptap/extension-document": "3.29.2",
    "@tiptap/extension-dropcursor": "3.29.2",
    "@tiptap/extension-floating-menu": "3.29.2",
    "@tiptap/extension-gapcursor": "3.29.2",
    "@tiptap/extension-hard-break": "3.29.2",
    "@tiptap/extension-heading": "3.29.2",
    "@tiptap/extension-horizontal-rule": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-italic": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/extension-list-item": "3.29.2",
    "@tiptap/extension-list-keymap": "3.29.2",
    "@tiptap/extension-ordered-list": "3.29.2",
    "@tiptap/extension-paragraph": "3.29.2",
    "@tiptap/extension-strike": "3.29.2",
    "@tiptap/extension-text": "3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2"
  }
}
