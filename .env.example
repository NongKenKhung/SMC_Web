# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่อง/เซิร์ฟเวอร์
DB_NAME=sml
DB_PASSWORD=change-me
# หมายเหตุ: ถ้าแก้ DB_PORT ต้องแก้พอร์ตใน DATABASE_URL ให้ตรงกันด้วย
# (DB_PORT ใช้โดย docker-compose, DATABASE_URL ใช้โดย Prisma/API — คนละตัวกัน)
DB_PORT=5430
DATABASE_URL=postgresql://postgres:change-me@localhost:5430/sml?schema=public
API_PORT=4000
WEB_ORIGIN=http://localhost:3100
JWT_SECRET=change-me-long-random-string
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ---------- อีเมลแจ้งเตือนฟอร์มติดต่อ ----------
# ปล่อยว่าง = ไม่ส่งอีเมล (ข้อความยังเก็บลง DB ตามปกติ)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS ต้องเป็น App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_NOTIFY_TO=

# ที่อยู่เว็บไซต์จริง (sitemap/robots/ลิงก์แชร์) — ตอน deploy ต้องเป็นโดเมนจริง
NEXT_PUBLIC_SITE_URL=http://localhost:3100
